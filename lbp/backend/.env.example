# Template only. The service manager must inject these variables into the process.
# Blank values need authorised configuration before the relevant feature is used.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
COOKIE_ENCRYPTION_SECRET=
PUBLIC_APP_URL=
CORS_ALLOWED_ORIGINS=

# Storage paths are examples, not existing server paths.
UPLOAD_DIR=./uploads
UPLOAD_URL_PREFIX=/uploads
PRIVATE_UPLOAD_DIR=./private/quarantine
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MIN_PROFILE_IMAGE_SIDE=200

# Only the authorised Firebase/Google Cloud project is supported.
EXPECTED_FIREBASE_PROJECT_ID=parents-698f8
FIREBASE_PROJECT_ID=parents-698f8
GOOGLE_APPLICATION_CREDENTIALS=
VISION_PROJECT_ID=parents-698f8
VISION_CREDENTIALS_PATH=
VISION_ENABLED=0
VISION_TIMEOUT_SECONDS=20
AUTOMATIC_PHOTO_RECHECK_LIMIT=100

# Optional mail delivery. Configure before enabling.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LetsBeParents
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT_SECONDS=20
EMAIL_NOTIFICATIONS_ENABLED=0

# Optional calls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CALL_RING_SECONDS=60

# Optional identity verification. Provider URL/workflow must be configured.
DIDIT_API_BASE=
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_ENABLED=0
DIDIT_TIMEOUT_SECONDS=20
DIDIT_PORTRAIT_TRANSPORT_BYTES=6144

# Optional support/partner configuration refers to records in the target database.
SUPPORT_PROFILE_SOURCE_ID=
PARTNER_API_PASSWORD=
PARTNER_SESSION_SECRET=
PARTNER_ACCOUNT_EMAIL=
PARTNER_DEFAULT_ID=
PARTNER_DEFAULT_CLINIC_ID=

# Optional administration of the shared API, not frontend build parameters.
ADMIN_API_USER=
ADMIN_API_PASSWORD=
ADMIN_TEST_USER=
ADMIN_TEST_PASSWORD=
ADMIN_DISABLED_LOGIN_EMAILS=
AMPLITUDE_API_KEY=
AMPLITUDE_USER_PROFILE_URL_TEMPLATE=
