# Copy this file to .env and fill in the real backend URL once you have it
# from the backend programmers. Expo only exposes vars prefixed EXPO_PUBLIC_
# to app code (see src/config.ts).
#
# Local dev example (backend running on your own machine, phone on the same
# wifi network, Expo Go app): use your computer's LAN IP, not "localhost" -
# the phone is a separate device and can't resolve "localhost" as your
# computer.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8000
#
# Real deployed backend - CONFIRMED by the backend programmer (Sept 2026),
# not a guess anymore: there is no separate api.* subdomain, Nginx proxies
# /api on this same domain through to the backend. Example he gave:
# POST https://test.letsbeparents.com/api/auth/login, docs at
# https://test.letsbeparents.com/api/docs. The app itself already appends
# "/api/..." to whatever you put here (see src/config.ts), so set this to
# the domain ALONE, with no "/api" on the end:
#   EXPO_PUBLIC_API_BASE_URL=https://test.letsbeparents.com
#
# NOTE the "test." prefix - this reads like a staging/test environment, not
# the bare production domain (letsbeparents.com). Worth double-checking with
# the programmer whether this is the address to keep testing against, or
# whether there's a separate production address to switch to before a real
# TestFlight/App Store release - he only confirmed the URL shape and the
# same-origin routing, not which environment this app should ultimately
# ship pointed at.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Only needed if the website's static files (Resources & Tools .docx
# downloads, served at /web-static/resources/*.docx) turn out to live on a
# DIFFERENT domain than the API above. Leave unset to reuse
# EXPO_PUBLIC_API_BASE_URL for those downloads too (see src/config.ts).
# EXPO_PUBLIC_SITE_BASE_URL=https://letsbeparents.com

# --- "Continue with Google" / "Continue with Apple" (see src/firebase.ts,
# src/components/SocialAuthButtons.tsx) -------------------------------------
#
# These must point at the SAME Firebase project the website already uses
# (lbp/frontend/.env's VITE_FIREBASE_* values) - the backend's
# POST /api/auth/firebase only accepts ID tokens from that one project.
#
# Where to get each value: Firebase Console (console.firebase.google.com) ->
# your project -> gear icon -> Project settings -> General -> scroll to
# "Your apps". If there's already a Web app registered there (there should
# be, since the website uses one), its "SDK setup and configuration" panel
# has all 6 values below - copy them as-is, they're the same for every app
# (web, iOS, Android) in one Firebase project. If you'd rather register a
# dedicated iOS/Android app entry in Firebase for this app, that's fine too
# (Add app -> iOS/Android, bundle ID com.letsBeParents.letsBeParents) - the apiKey/
# authDomain/projectId/etc. values will be identical either way.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client ID(s) for expo-auth-session (a DIFFERENT thing from
# the Firebase values above - this is what lets the Google sign-in sheet
# itself open). Get these from Google Cloud Console
# (console.cloud.google.com) -> pick the SAME project as the Firebase
# project above (Firebase projects ARE Google Cloud projects) -> APIs &
# Services -> Credentials. Firebase auto-creates a "Web client (auto created
# by Google Service)" entry there the moment Google sign-in is turned on in
# Firebase Authentication - use that one's Client ID for the "web" value
# below. For real iOS/Android builds (not just Expo Go), also create an iOS
# and/or Android OAuth client ID in that same list (iOS needs the bundle ID
# com.letsBeParents.letsBeParents; Android needs the package name
# com.letsBeParents.letsBeParents plus a SHA-1 certificate fingerprint,
# which EAS Build can provide once that's set up).
#
# NOTE: this is confirmed as the real identifier already registered in both
# Google Cloud Console and Apple Developer - it matches app.json's
# ios.bundleIdentifier / android.package exactly (they must match byte-for-
# byte or Google/Apple will reject the sign-in).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Apple: no .env value needed - expo-apple-authentication uses the native
# "Sign In with Apple" capability instead (already set in app.json as
# ios.usesAppleSignIn). The one thing that needs doing in Apple Developer
# (developer.apple.com -> Certificates, IDs & Profiles -> Identifiers -> the
# com.letsBeParents.letsBeParents App ID) is ticking the "Sign In with Apple"
# capability checkbox - EAS Build can also do this automatically when it
# manages credentials, if that's the route taken.
